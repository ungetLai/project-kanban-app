# Upstash Redis 環境變數
# 這些變數會在 Vercel Dashboard 自動設定
# 當您在 Vercel 啟用 Upstash Redis 整合後，會自動注入這些環境變數

KV_REST_API_URL=your_redis_rest_api_url
KV_REST_API_TOKEN=your_redis_rest_api_token

# 權限驗證設定 (Security Settings)
ADMIN_TG_ID=8491288413
ADMIN_USERNAME=ungetLai
AUTH_SALT=your_custom_salt_here
TG_BOT_TOKEN=your_telegram_bot_token_if_needed

# 設定步驟：
# 1. 前往 Vercel Dashboard
# 2. 選擇您的專案
# 3. 進入 "Storage" 或 "Integrations"
# 4. 新增 "Upstash Redis"
# 5. 手動新增 ADMIN_TG_ID, ADMIN_USERNAME, AUTH_SALT 等變數
